{
  "name": "french-learning",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs",
    "check:i18n": "node scripts/check-i18n-parity.cjs",
    "check:content": "node scripts/validate-content.cjs",
    "check:trace": "node scripts/validate-trace-data.cjs",
    "generate:trace": "node scripts/generate-print-trace.cjs && node scripts/generate-cursive-line.cjs",
    "generate:print": "node scripts/generate-print-trace.cjs",
    "smooth:trace": "node scripts/smooth-trace-data.cjs",
    "author:trace": "node scripts/trace-authoring.cjs",
    "preview:trace": "node scripts/preview-trace-data.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:i18n && npm run build"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lottie-react": "^3.1.1",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^25.0.1",
    "opentype.js": "^2.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
